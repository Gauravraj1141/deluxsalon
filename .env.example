# PostgreSQL connection string used by the backend.
# In docker-compose, "postgres" resolves to the postgres service on the shared network.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/music_db

# Admin panel credentials (never commit real values).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Secret key used to sign the admin session cookie. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=&%#5f6g8+q61_wvcvwce2()j8s#5^cezhq68yfzkr!b=6b$=8g

# "production" enables secure (HTTPS-only) session cookies.
APP_ENV=production

# Browser origins allowed to call the API, as a JSON array.
CORS_ORIGINS=["https://deluxesalonsongs.com","https://www.deluxesalonsongs.com","http://localhost:3000"]
